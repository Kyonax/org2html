{
  "name": "@kyonax/org2html",
  "version": "1.1.0",
  "description": "CLI that converts Org-mode (.org) files into clean, accessible, SEO-ready HTML (and Vue SFCs)",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "org2html": "./dist/cli/index.mjs"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "smoke": "node scripts/smoke-install.mjs",
    "check:version": "node scripts/check-version.mjs",
    "test:coverage": "vitest --coverage",
    "prepublishOnly": "npm run build",
    "scan:corpus": "node scripts/corpus-scan.mjs",
    "scan:perf": "node scripts/scan-perf.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kyonax/org2html.git"
  },
  "bugs": {
    "url": "https://github.com/Kyonax/org2html/issues"
  },
  "homepage": "https://github.com/Kyonax/org2html#readme",
  "keywords": [
    "org-mode",
    "org2html",
    "orgmode",
    "parser",
    "html",
    "cli",
    "esm",
    "ssg",
    "vue3",
    "seo",
    "static-site-generator"
  ],
  "author": {
    "name": "Cristian D. Moreno - Kyonax",
    "url": "https://github.com/Kyonax"
  },
  "maintainers": [
    {
      "name": "Cristian D. Moreno - Kyonax",
      "url": "https://orcid.org/0009-0006-4459-5538"
    }
  ],
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/kyonax"
  },
  "license": "GPL-3.0-only",
  "files": [
    "dist",
    "!dist/**/*.map",
    "templates",
    "!templates/style-book",
    "templates/style-book/README.md",
    "templates/style-book/stylebook.json",
    "templates/style-book/kwo-tokens.css",
    "templates/style-book/kwo.css",
    "templates/style-book/o2h-tokens.css",
    "templates/style-book/o2h/stylebook.json",
    "templates/style-book/o2h/README.md",
    "!templates/fonts",
    "NOTICE",
    "LICENSE-EXCEPTION.txt",
    "docs"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "chokidar": "^3.5.3",
    "commander": "^11.1.0",
    "dompurify": "^3.4.15",
    "fast-glob": "^3.3.2",
    "jsdom": "^26.0.0",
    "probe-image-size": "^7.2.3",
    "shiki": "^0.14.5",
    "slugify": "1.6.9",
    "temml": "^0.13.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/dompurify": "^3.0.5",
    "@types/jsdom": "^21.1.6",
    "@types/node": "^20.10.0",
    "@vitest/coverage-v8": "^4.1.11",
    "@vue/compiler-sfc": "^3.5.42",
    "axe-core": "^4.12.1",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "jiti": "^2.6.1",
    "sharp": "^0.35.4",
    "tsup": "^8.0.1",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.49.0",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=18.13.0"
  }
}
