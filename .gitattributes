#
# .gitattributes — Per-path encoding + EOL discipline
# 2026-05-21
#
# Pins UTF-8 + LF on files that may carry Unicode glyphs so Windows
# clones cannot silently corrupt PUA codepoints with CRLF + BOM.
#
# Guidelines:
#   Use \uXXXX escapes in JS/TS strings, never typed raw glyphs

# ── Per-file pins (UTF-8 + LF) ───────────────────────────────
templates/default.html        text eol=lf working-tree-encoding=UTF-8
templates/styles.css          text eol=lf working-tree-encoding=UTF-8
templates/manifest.json       text eol=lf working-tree-encoding=UTF-8
templates/favicon.svg         text eol=lf working-tree-encoding=UTF-8
src/cli/vue-generator.ts      text eol=lf working-tree-encoding=UTF-8

# ── Repo-wide default ────────────────────────────────────────
* text=auto
